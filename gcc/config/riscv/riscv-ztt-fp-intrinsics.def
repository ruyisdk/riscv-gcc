/* Floating format/RM are type identity, not physical storage modes.  */

#include "riscv-ztt-catalog-iterators.h"

/* Shape-specific operation groups retain the original builtin order.
   Q32 has no larger input for extract; 1x1 has a column extractor.  */
#define ZTT_FP_VALUES_SINGLE(TYPE, NAME) \
  ZTT_INTRINSIC (MCLEAR_M##_##TYPE, "__riscv_ztt_mclear_m_" #NAME, \
		 M_VOID, MCLEAR_M, TYPE) \
  ZTT_INTRINSIC (MZERO_M##_##TYPE, "__riscv_ztt_mzero_m_" #NAME, \
		 M_VOID, MZERO_2D_M, TYPE) \
  ZTT_INTRINSIC (MCOPY_M2M##_##TYPE, "__riscv_ztt_mcopy_m2m_" #NAME, \
		 M_M, MCOPY_M2M, TYPE) \
  ZTT_INTRINSIC (MEXTRACT##_##TYPE, "__riscv_ztt_mextract_" #NAME, \
		 M_EXTRACT, MEXTRACT, TYPE) \
  ZTT_INTRINSIC (MEXTRACT_COLUMN##_##TYPE, "__builtin_riscv_ztt_mextract_column_" #NAME, \
		 M_EXTRACT_COLUMN, MEXTRACT, TYPE) \
  ZTT_INTRINSIC (MCONV_EW##_##TYPE, "__riscv_ztt_mconv_ew_" #NAME, \
		 M_CONVERT, MCONV_EW, TYPE) \
  ZTT_INTRINSIC (MABS_EW##_##TYPE, "__riscv_ztt_mabs_ew_" #NAME, \
		 M_ABS, MABS_EW, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_COL##_##TYPE, "__riscv_ztt_mreduceadd_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_ROW##_##TYPE, "__riscv_ztt_mreduceadd_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_COL##_##TYPE, "__riscv_ztt_mreducemax_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_ROW##_##TYPE, "__riscv_ztt_mreducemax_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_COL##_##TYPE, "__riscv_ztt_mreducemin_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_ROW##_##TYPE, "__riscv_ztt_mreducemin_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_COL##_##TYPE, "__riscv_ztt_mprefixadd_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_ROW##_##TYPE, "__riscv_ztt_mprefixadd_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_COL##_##TYPE, "__riscv_ztt_mprefixmax_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_ROW##_##TYPE, "__riscv_ztt_mprefixmax_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_ROW, TYPE) \
  ZTT_INTRINSIC (MFRINTM_EW##_##TYPE, "__riscv_ztt_mfrintm_ew_" #NAME, \
		 M_STRUCTURAL, MFRINTM_EW, TYPE) \
  ZTT_INTRINSIC (MFRINTN_EW##_##TYPE, "__riscv_ztt_mfrintn_ew_" #NAME, \
		 M_STRUCTURAL, MFRINTN_EW, TYPE) \
  ZTT_INTRINSIC (MFRINTP_EW##_##TYPE, "__riscv_ztt_mfrintp_ew_" #NAME, \
		 M_STRUCTURAL, MFRINTP_EW, TYPE) \
  ZTT_INTRINSIC (MFRINTZ_EW##_##TYPE, "__riscv_ztt_mfrintz_ew_" #NAME, \
		 M_STRUCTURAL, MFRINTZ_EW, TYPE) \
  ZTT_INTRINSIC (MEXP2_EW##_##TYPE, "__riscv_ztt_mexp2_ew_" #NAME, \
		 M_STRUCTURAL, MEXP2_EW, TYPE) \
  ZTT_INTRINSIC (MLOG2_EW##_##TYPE, "__riscv_ztt_mlog2_ew_" #NAME, \
		 M_STRUCTURAL, MLOG2_EW, TYPE) \
  ZTT_INTRINSIC (MCOS_EW##_##TYPE, "__riscv_ztt_mcos_ew_" #NAME, \
		 M_STRUCTURAL, MCOS_EW, TYPE) \
  ZTT_INTRINSIC (MSIN_EW##_##TYPE, "__riscv_ztt_msin_ew_" #NAME, \
		 M_STRUCTURAL, MSIN_EW, TYPE) \
  ZTT_INTRINSIC (MTANH_EW##_##TYPE, "__riscv_ztt_mtanh_ew_" #NAME, \
		 M_STRUCTURAL, MTANH_EW, TYPE) \
  ZTT_INTRINSIC (MREC_EW##_##TYPE, "__riscv_ztt_mrec_ew_" #NAME, \
		 M_STRUCTURAL, MREC_EW, TYPE) \
  ZTT_INTRINSIC (MRSQRT_EW##_##TYPE, "__riscv_ztt_mrsqrt_ew_" #NAME, \
		 M_STRUCTURAL, MRSQRT_EW, TYPE) \
  ZTT_INTRINSIC (MSQRT_EW##_##TYPE, "__riscv_ztt_msqrt_ew_" #NAME, \
		 M_STRUCTURAL, MSQRT_EW, TYPE)

