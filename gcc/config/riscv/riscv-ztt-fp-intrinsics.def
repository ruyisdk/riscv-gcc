ZTT_FP_MATMUL_TYPE (BF16_RNO, bf16_rno)
ZTT_FP_MATMUL_TYPE (F32_RNE, f32_rne)
ZTT_FP_MATMUL_TYPE (F32_RTZ, f32_rtz)
