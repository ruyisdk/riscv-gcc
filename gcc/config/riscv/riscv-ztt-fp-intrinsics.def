/* FP result anchors; independent source types resolve lazily.  */
#define ZTT_FP_MATMUL_ENTRY(ID, NAME, K, OP, SPELL, EXPAND) \
  ZTT_INTRINSIC (OP##_2D_##ID##_ACCX##K, \
                 "__riscv_ztt_" #SPELL "_2d_" #NAME "_accx" #K, \
                 A_A_M_M, EXPAND, ID##_ACCX##K)
#define ZTT_FP_MATMUL_K(ID, NAME, K) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULACC, mmulacc, A_MMUL) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULACCNEG, mmulaccneg, A_MMULNEG) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULATACC, mmulatacc, A_MMULAT) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULATACCNEG, mmulataccneg, A_MMULATNEG) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULBTACC, mmulbtacc, A_MMULBT) \
  ZTT_FP_MATMUL_ENTRY (ID, NAME, K, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG)
#define ZTT_FP_MATMUL_TYPE(ID, NAME) \
  ZTT_FP_MATMUL_K (ID, NAME, 1) \
  ZTT_FP_MATMUL_K (ID, NAME, 2) \
  ZTT_FP_MATMUL_K (ID, NAME, 4) \
  ZTT_FP_MATMUL_K (ID, NAME, 8) \
  ZTT_FP_MATMUL_K (ID, NAME, 16)
ZTT_FP_MATMUL_TYPE (F16_RNE, f16_rne)
ZTT_FP_MATMUL_TYPE (F16_RTZ, f16_rtz)
ZTT_FP_MATMUL_TYPE (F16_RDN, f16_rdn)
ZTT_FP_MATMUL_TYPE (F16_RUP, f16_rup)
ZTT_FP_MATMUL_TYPE (F16_RMM, f16_rmm)
ZTT_FP_MATMUL_TYPE (F16_RNO, f16_rno)
