/* Matrix mathematics; compile contracts are not numerical execution.  */

#include "riscv-ztt-catalog-iterators.h"

/* Operation-major order is part of the canonical builtin numbering.  */
#define ZTT_MATRIX_MATH_ENTRY(TYPE, NAME, OP, SPELLING, PROTO) \
  ZTT_INTRINSIC (OP##_##TYPE, "__riscv_ztt_" #SPELLING "_" #NAME, \
		 PROTO, OP, TYPE)

#define ZTT_MATRIX_MATH_SHAPES(TYPE, NAME, OP, SPELLING, PROTO) \
  ZTT_CATALOG_M_SHAPES (ZTT_MATRIX_MATH_ENTRY, TYPE, NAME, \
			OP, SPELLING, PROTO)

ZTT_CATALOG_ALL_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MLDEXP_EW, mldexp_ew, M_BINARY_M)
ZTT_CATALOG_ALL_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MRDEXP_EW, mrdexp_ew, M_BINARY_M)
ZTT_CATALOG_ALL_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MLDEXPACC_EW, mldexpacc_ew, M_TERNARY_M)
ZTT_CATALOG_ALL_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MRDEXPACC_EW, mrdexpacc_ew, M_TERNARY_M)
ZTT_CATALOG_FP_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MLOG2SUB_EW, mlog2sub_ew, M_BINARY_M)
ZTT_CATALOG_FP_TYPES (ZTT_MATRIX_MATH_SHAPES,
		       MSUBLOG2_EW, msublog2_ew, M_BINARY_M)

#undef ZTT_MATRIX_MATH_ENTRY
#undef ZTT_MATRIX_MATH_SHAPES

/* Floating memory keeps full native elements on both XLENs.  */

/* Operation groups preserve the existing catalog order and builtin codes.  */
#define ZTT_FP_MEMORY_TYPE(TYPE, NAME) \
  ZTT_INTRINSIC (MLS_RM##_##TYPE, "__riscv_ztt_mls_rm_" #NAME, \
		 M_CONST_PTR, MLS_RM, TYPE) \
  ZTT_INTRINSIC (MSS_RM##_##TYPE, "__riscv_ztt_mss_rm_" #NAME, \
		 VOID_PTR_M, MSS_RM, TYPE) \
  ZTT_INTRINSIC (MLS_CM##_##TYPE, "__riscv_ztt_mls_cm_" #NAME, \
		 M_CONST_PTR, MLS_CM, TYPE) \
  ZTT_INTRINSIC (MSS_CM##_##TYPE, "__riscv_ztt_mss_cm_" #NAME, \
		 VOID_PTR_M, MSS_CM, TYPE) \
  ZTT_INTRINSIC (MLS_ST##_##TYPE, "__riscv_ztt_mls_st_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_ST, TYPE) \
  ZTT_INTRINSIC (MSS_ST##_##TYPE, "__riscv_ztt_mss_st_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_ST, TYPE) \
  ZTT_INTRINSIC (MLS_TST##_##TYPE, "__riscv_ztt_mls_tst_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_TST, TYPE) \
  ZTT_INTRINSIC (MSS_TST##_##TYPE, "__riscv_ztt_mss_tst_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_TST, TYPE)

