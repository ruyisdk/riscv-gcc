// Bitmanip (manual "Bitmanip" section, spec lines 48-133): suffixed names.
// cls_32: RV32=cls, RV64=clsw. cls_64: RV64=cls. rev_32: RV32=rev, RV64=rev+srai.
// rev_64/rev16_64: RV64 only. slx/srx_32: RV32 single, RV64 sequence. slx/srx_64: RV64 single.
// wzip8p/16p_64: RV32 wzip(regpair), RV64 zip. zip/unzip*_64: RV64 only.
RISCV_BUILTIN (cls_32_p,     "cls_32",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_SI,     simd),
RISCV_BUILTIN (cls_64_p,     "cls_64",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_DI,     simd64),
RISCV_BUILTIN (rev_32_p,     "rev_32",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_USI,     simd),
RISCV_BUILTIN (rev_64_p,     "rev_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI,     simd64),
RISCV_BUILTIN (rev16_64_p,     "rev16_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI,     simd64),
RISCV_BUILTIN (slx_32_p,     "slx_32",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_USI_USI_USI,     simd),
RISCV_BUILTIN (srx_32_p,     "srx_32",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_USI_USI_USI,     simd),
RISCV_BUILTIN (slx_64_p,     "slx_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI_USI,     simd64),
RISCV_BUILTIN (srx_64_p,     "srx_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI_USI,     simd64),
RISCV_BUILTIN (wzip8p_64_p,     "wzip8p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_USI_USI,     simd),
RISCV_BUILTIN (wzip16p_64_p,     "wzip16p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_USI_USI,     simd),
RISCV_BUILTIN (zip8p_64_p,     "zip8p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (zip16p_64_p,     "zip16p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (zip8hp_64_p,     "zip8hp_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (zip16hp_64_p,     "zip16hp_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (unzip8p_64_p,     "unzip8p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (unzip16p_64_p,     "unzip16p_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (unzip8hp_64_p,     "unzip8hp_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),
RISCV_BUILTIN (unzip16hp_64_p,     "unzip16hp_64",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_UDI,     simd64),

