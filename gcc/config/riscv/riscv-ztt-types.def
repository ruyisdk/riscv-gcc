#ifdef ZTT_ACC_TUPLE
/* Append after accx1 types;
   availability requires whole transfer packets, K*D/UDS <= 4 and at
   least K ACCs.  Packed groups have copy support, not matmul support.  */
#define ZTT_ACC_TUPLE_RMS(ID, NAME, LEN, DESC, K) \
  ZTT_ACC_TUPLE (ID##_RNU, NAME##_rnu, LEN, DESC, \
                 "__riscv_ztt_" #NAME "_accx" #K "_t", K) \
  ZTT_ACC_TUPLE (ID##_RNE, NAME##_rne, LEN, (DESC) | 0x08000000, nullptr, K) \
  ZTT_ACC_TUPLE (ID##_RDN, NAME##_rdn, LEN, (DESC) | 0x10000000, nullptr, K) \
  ZTT_ACC_TUPLE (ID##_ROD, NAME##_rod, LEN, (DESC) | 0x18000000, nullptr, K)
ZTT_ACC_TUPLE_RMS (I8, i8, 26, 0x40000008, 2)
ZTT_ACC_TUPLE_RMS (I8, i8, 26, 0x40000008, 4)
ZTT_ACC_TUPLE_RMS (U8, u8, 26, 0x00000008, 2)
ZTT_ACC_TUPLE_RMS (U8, u8, 26, 0x00000008, 4)
ZTT_ACC_TUPLE_RMS (I16, i16, 27, 0x40000010, 2)
ZTT_ACC_TUPLE_RMS (I16, i16, 27, 0x40000010, 4)
ZTT_ACC_TUPLE_RMS (U16, u16, 27, 0x00000010, 2)
ZTT_ACC_TUPLE_RMS (U16, u16, 27, 0x00000010, 4)
ZTT_ACC_TUPLE_RMS (I32, i32, 27, 0x40000020, 2)
ZTT_ACC_TUPLE_RMS (I32, i32, 27, 0x40000020, 4)
ZTT_ACC_TUPLE_RMS (U32, u32, 27, 0x00000020, 2)
ZTT_ACC_TUPLE_RMS (U32, u32, 27, 0x00000020, 4)
#undef ZTT_ACC_TUPLE_RMS
#endif /* ZTT_ACC_TUPLE */

#ifdef ZTT_ACC_LARGE
/* Append type identities
   and copy entries separately from the earlier tuple include.  These
   values require complete packets and at most four M payload registers.  */
#define ZTT_ACC_LARGE_RMS(ID, NAME, LEN, DESC, K) \
  ZTT_ACC_LARGE (ID##_RNU, NAME##_rnu, LEN, DESC, \
                 "__riscv_ztt_" #NAME "_accx" #K "_t", K) \
  ZTT_ACC_LARGE (ID##_RNE, NAME##_rne, LEN, (DESC) | 0x08000000, nullptr, K) \
  ZTT_ACC_LARGE (ID##_RDN, NAME##_rdn, LEN, (DESC) | 0x10000000, nullptr, K) \
  ZTT_ACC_LARGE (ID##_ROD, NAME##_rod, LEN, (DESC) | 0x18000000, nullptr, K)
ZTT_ACC_LARGE_RMS (I8, i8, 26, 0x40000008, 8)
ZTT_ACC_LARGE_RMS (I8, i8, 27, 0x40000008, 16)
ZTT_ACC_LARGE_RMS (U8, u8, 26, 0x00000008, 8)
ZTT_ACC_LARGE_RMS (U8, u8, 27, 0x00000008, 16)
ZTT_ACC_LARGE_RMS (I16, i16, 27, 0x40000010, 8)
ZTT_ACC_LARGE_RMS (I16, i16, 28, 0x40000010, 16)
ZTT_ACC_LARGE_RMS (U16, u16, 27, 0x00000010, 8)
ZTT_ACC_LARGE_RMS (U16, u16, 28, 0x00000010, 16)
ZTT_ACC_LARGE_RMS (I32, i32, 27, 0x40000020, 8)
ZTT_ACC_LARGE_RMS (I32, i32, 28, 0x40000020, 16)
ZTT_ACC_LARGE_RMS (U32, u32, 27, 0x00000020, 8)
ZTT_ACC_LARGE_RMS (U32, u32, 28, 0x00000020, 16)
#undef ZTT_ACC_LARGE_RMS
#endif /* ZTT_ACC_LARGE */

