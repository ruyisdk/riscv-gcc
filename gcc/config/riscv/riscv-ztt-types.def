/* Ztt type catalog.
   Define the entry macros for the sections to expand.  This file
   is intentionally included more than once.  Keep section and row
   order stable: it determines type or operation indices.  */

#ifdef ZTT_M_TYPE
/* Public integer 1x1 types for the compiler-only AME/Ztt profiles.

   Integer RM occupies descriptor bits [28:27], not machine-mode identity.  */

ZTT_M_TYPE (I8_RNE_1X1, __riscv_ztt_i8_rne_1x1_t,
	    "u24__riscv_ztt_i8_rne_1x1_t", 0x48000008, nullptr)
ZTT_M_TYPE (I8_RNU_1X1, __riscv_ztt_i8_rnu_1x1_t,
	    "u24__riscv_ztt_i8_rnu_1x1_t", 0x40000008, "__riscv_ztt_i8_1x1_t")
ZTT_M_TYPE (I8_RDN_1X1, __riscv_ztt_i8_rdn_1x1_t,
	    "u24__riscv_ztt_i8_rdn_1x1_t", 0x50000008, nullptr)
ZTT_M_TYPE (I8_ROD_1X1, __riscv_ztt_i8_rod_1x1_t,
	    "u24__riscv_ztt_i8_rod_1x1_t", 0x58000008, nullptr)

