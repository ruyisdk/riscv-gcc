#undef ZTT_MEMORY_OP
#undef ZTT_MEMORY_RMS
#undef ZTT_MEMORY_TYPE
#undef ZTT_MEMORY_SHAPE

/* Scalar old-D anchors
   retain explicit TC/RM; resolve the matrix source type lazily.  */
#define ZTT_TERNARY_X_ENTRY(OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME, CRM, CSUFFIX) \
  ZTT_INTRINSIC (OP##_##DID##_##DRM##_##SHAPE##_##CID##_##CRM, \
                 "__riscv_ztt_" #NAME "_" #DNAME "_" #DSUFFIX "_" #SNAME \
                 "_" #CNAME "_" #CSUFFIX, \
                 M_TERNARY_X_##CID##_##CRM, OP, DID##_##DRM##_##SHAPE)
#define ZTT_TERNARY_X_SOURCE(OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME) \
  ZTT_TERNARY_X_ENTRY (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME, RNU, rnu) \
  ZTT_TERNARY_X_ENTRY (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME, RNE, rne) \
  ZTT_TERNARY_X_ENTRY (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME, RDN, rdn) \
  ZTT_TERNARY_X_ENTRY (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, CID, CNAME, ROD, rod)
#define ZTT_TERNARY_X_SHAPE(OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, I8, i8) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, U8, u8) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, I16, i16) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, U16, u16) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, I32, i32) \
  ZTT_TERNARY_X_SOURCE (OP, NAME, DID, DNAME, DRM, DSUFFIX, SHAPE, SNAME, U32, u32)
#define ZTT_TERNARY_X_TYPE(OP, NAME, DID, DNAME, DRM, DSUFFIX) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X1, 1x1) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X2, 1x2) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 2X1, 2x1) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X4, 1x4) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 4X1, 4x1) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X8, 1x8) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 8X1, 8x1) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X16, 1x16) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 16X1, 16x1) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 1X32, 1x32) \
  ZTT_TERNARY_X_SHAPE (OP, NAME, DID, DNAME, DRM, DSUFFIX, 32X1, 32x1)
#define ZTT_TERNARY_X_RMS(OP, NAME, DID, DNAME) \
  ZTT_TERNARY_X_TYPE (OP, NAME, DID, DNAME, RNU, rnu) \
  ZTT_TERNARY_X_TYPE (OP, NAME, DID, DNAME, RNE, rne) \
  ZTT_TERNARY_X_TYPE (OP, NAME, DID, DNAME, RDN, rdn) \
  ZTT_TERNARY_X_TYPE (OP, NAME, DID, DNAME, ROD, rod)
#define ZTT_TERNARY_X_OP(OP, NAME) \
  ZTT_TERNARY_X_RMS (OP, NAME, I8, i8) \
  ZTT_TERNARY_X_RMS (OP, NAME, U8, u8) \
  ZTT_TERNARY_X_RMS (OP, NAME, I16, i16) \
  ZTT_TERNARY_X_RMS (OP, NAME, U16, u16) \
  ZTT_TERNARY_X_RMS (OP, NAME, I32, i32) \
  ZTT_TERNARY_X_RMS (OP, NAME, U32, u32)
ZTT_TERNARY_X_OP (MMULACC_EW_X, mmulacc_ew_x)
ZTT_TERNARY_X_OP (MMULACCNEG_EW_X, mmulaccneg_ew_x)
ZTT_TERNARY_X_OP (MMULADD_EW_X, mmuladd_ew_x)
