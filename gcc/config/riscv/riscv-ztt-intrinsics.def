#undef ZTT_TERNARY_OP
#undef ZTT_TERNARY_RMS
#undef ZTT_TERNARY_TYPE
#undef ZTT_TERNARY_SHAPE

/* v0.2.4 memory operations;
   append IDs so existing declarations and LTO codes remain stable.  */
#define ZTT_MEMORY_SHAPE(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME) \
  ZTT_INTRINSIC (OP##_##ID##_##RM##_##SHAPE, \
                 "__riscv_ztt_" #NAME "_" #TYPE "_" #SUFFIX "_" #SNAME, \
                 PROTO, OP, ID##_##RM##_##SHAPE)
#define ZTT_MEMORY_TYPE(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X1, 1x1) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X2, 1x2) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 2X1, 2x1) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X4, 1x4) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 4X1, 4x1) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X8, 1x8) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 8X1, 8x1) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X16, 1x16) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 16X1, 16x1) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X32, 1x32) \
  ZTT_MEMORY_SHAPE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 32X1, 32x1)
#define ZTT_MEMORY_RMS(OP, NAME, PROTO, ID, TYPE) \
  ZTT_MEMORY_TYPE (OP, NAME, PROTO, ID, TYPE, RNU, rnu) \
  ZTT_MEMORY_TYPE (OP, NAME, PROTO, ID, TYPE, RNE, rne) \
  ZTT_MEMORY_TYPE (OP, NAME, PROTO, ID, TYPE, RDN, rdn) \
  ZTT_MEMORY_TYPE (OP, NAME, PROTO, ID, TYPE, ROD, rod)
#define ZTT_MEMORY_OP(OP, NAME, PROTO) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, I8, i8) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, U8, u8) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, I16, i16) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, U16, u16) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, I32, i32) \
  ZTT_MEMORY_RMS (OP, NAME, PROTO, U32, u32)
ZTT_MEMORY_OP (MLS_CM, mls_cm, M_CONST_PTR)
ZTT_MEMORY_OP (MSS_CM, mss_cm, VOID_PTR_M)
ZTT_MEMORY_OP (MLS_ST, mls_st, M_CONST_PTR_STRIDE)
ZTT_MEMORY_OP (MSS_ST, mss_st, VOID_PTR_STRIDE_M)
ZTT_MEMORY_OP (MLS_TST, mls_tst, M_CONST_PTR_STRIDE)
ZTT_MEMORY_OP (MSS_TST, mss_tst, VOID_PTR_STRIDE_M)
ZTT_INTRINSIC (MSS_CM_DISPATCH, "__riscv_ztt_mss_cm",
               VOID_PTR_M, MSS_CM, I8_RNU_1X1)
ZTT_INTRINSIC (MSS_ST_DISPATCH, "__riscv_ztt_mss_st",
               VOID_PTR_STRIDE_M, MSS_ST, I8_RNU_1X1)
ZTT_INTRINSIC (MSS_TST_DISPATCH, "__riscv_ztt_mss_tst",
