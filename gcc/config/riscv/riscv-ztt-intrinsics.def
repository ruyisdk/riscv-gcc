  ZTT_TERNARY_SHAPE (OP, NAME, ID, TYPE, RM, SUFFIX, 8X1, 8x1) \
  ZTT_TERNARY_SHAPE (OP, NAME, ID, TYPE, RM, SUFFIX, 1X16, 1x16) \
  ZTT_TERNARY_SHAPE (OP, NAME, ID, TYPE, RM, SUFFIX, 16X1, 16x1) \
