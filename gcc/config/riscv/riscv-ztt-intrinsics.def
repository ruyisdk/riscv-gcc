               A_A_M_M, A_MMUL, I32_RNU_ACCX1)

/* Keep old builtin indices;
   availability follows the existing M type and profile registry.  */
#define ZTT_COPY_RM(ID, NAME, RM, SUFFIX) \
  ZTT_INTRINSIC (MCOPY_M2M_##ID##_##RM##_1X1, \
                 "__riscv_ztt_mcopy_m2m_" #NAME "_" #SUFFIX "_1x1", \
                 M_M, MCOPY_M2M, ID##_##RM##_1X1)
#define ZTT_COPY_TYPE(ID, NAME) \
  ZTT_COPY_RM (ID, NAME, RNU, rnu) \
  ZTT_COPY_RM (ID, NAME, RNE, rne) \
  ZTT_COPY_RM (ID, NAME, RDN, rdn) \
  ZTT_COPY_RM (ID, NAME, ROD, rod)
