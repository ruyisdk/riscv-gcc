  ZTT_TERNARY_TYPE (OP, NAME, ID, TYPE, RNU, rnu) \
  ZTT_TERNARY_TYPE (OP, NAME, ID, TYPE, RNE, rne) \
  ZTT_TERNARY_TYPE (OP, NAME, ID, TYPE, RDN, rdn) \
  ZTT_TERNARY_TYPE (OP, NAME, ID, TYPE, ROD, rod)
