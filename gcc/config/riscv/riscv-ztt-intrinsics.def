/* Append ordered compare
   and representation-preserving selection anchors.  */
#define ZTT_COMPARE_M_SHAPE(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME) \
  ZTT_INTRINSIC (OP##_##ID##_##RM##_##SHAPE, \
                 "__riscv_ztt_" #NAME "_" #TYPE "_" #SUFFIX "_" #SNAME, \
                 PROTO, OP, ID##_##RM##_##SHAPE)
#define ZTT_COMPARE_X_ENTRY(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME, CRM, CSUFFIX) \
  ZTT_INTRINSIC (OP##_##ID##_##RM##_##SHAPE##_##CID##_##CRM, \
                 "__riscv_ztt_" #NAME "_" #TYPE "_" #SUFFIX "_" #SNAME \
                 "_" #CNAME "_" #CSUFFIX, \
                 PROTO##_##CID##_##CRM, OP, ID##_##RM##_##SHAPE)
#define ZTT_COMPARE_X_SOURCE(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME) \
  ZTT_COMPARE_X_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME, RNU, rnu) \
  ZTT_COMPARE_X_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME, RNE, rne) \
  ZTT_COMPARE_X_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME, RDN, rdn) \
  ZTT_COMPARE_X_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, CID, CNAME, ROD, rod)
#define ZTT_COMPARE_X_SHAPE(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, I8, i8) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, U8, u8) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, I16, i16) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, U16, u16) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, I32, i32) \
  ZTT_COMPARE_X_SOURCE (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SNAME, U32, u32)
#define ZTT_COMPARE_TYPE(APPLY, OP, NAME, PROTO, ID, TYPE, RM, SUFFIX) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X1, 1x1) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X2, 1x2) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 2X1, 2x1) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X4, 1x4) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 4X1, 4x1) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X8, 1x8) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 8X1, 8x1) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X16, 1x16) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 16X1, 16x1) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X32, 1x32) \
  APPLY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 32X1, 32x1)
#define ZTT_COMPARE_RMS(APPLY, OP, NAME, PROTO, ID, TYPE) \
  ZTT_COMPARE_TYPE (APPLY, OP, NAME, PROTO, ID, TYPE, RNU, rnu) \
  ZTT_COMPARE_TYPE (APPLY, OP, NAME, PROTO, ID, TYPE, RNE, rne) \
  ZTT_COMPARE_TYPE (APPLY, OP, NAME, PROTO, ID, TYPE, RDN, rdn) \
  ZTT_COMPARE_TYPE (APPLY, OP, NAME, PROTO, ID, TYPE, ROD, rod)
#define ZTT_COMPARE_OP(APPLY, OP, NAME, PROTO) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, I8, i8) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, U8, u8) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, I16, i16) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, U16, u16) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, I32, i32) \
  ZTT_COMPARE_RMS (APPLY, OP, NAME, PROTO, U32, u32)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MCMOVGE_EW, mcmovge_ew, M_TERNARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MCMOVLT_EW, mcmovlt_ew, M_TERNARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MCMPGE_EW, mcmpge_ew, M_BINARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MCMPLT_EW, mcmplt_ew, M_BINARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MSELGE_EW, mselge_ew, M_BINARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_M_SHAPE, MSELLT_EW, msellt_ew, M_BINARY_M)
ZTT_COMPARE_OP (ZTT_COMPARE_X_SHAPE, MCMPGE_EW_X, mcmpge_ew_x, M_SCALAR)
ZTT_COMPARE_OP (ZTT_COMPARE_X_SHAPE, MCMPLT_EW_X, mcmplt_ew_x, M_SCALAR)
#undef ZTT_COMPARE_OP
#undef ZTT_COMPARE_RMS
#undef ZTT_COMPARE_TYPE
#undef ZTT_COMPARE_X_SHAPE
#undef ZTT_COMPARE_X_SOURCE
#undef ZTT_COMPARE_X_ENTRY
#undef ZTT_COMPARE_M_SHAPE

