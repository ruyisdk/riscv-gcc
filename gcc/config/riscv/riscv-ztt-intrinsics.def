ZTT_COPY_TYPE (U8, u8)
ZTT_COPY_TYPE (I16, i16)
ZTT_COPY_TYPE (U16, u16)
ZTT_COPY_TYPE (I32, i32)
ZTT_COPY_TYPE (U32, u32)
#undef ZTT_COPY_TYPE
#undef ZTT_COPY_RM

#define ZTT_M_SHAPE(ID, NAME, MANGLED, DESC, ALIAS, ROWS, COLS) \
  ZTT_INTRINSIC (MCOPY_M2M_##ID, "__riscv_ztt_mcopy_m2m_" #NAME, \
                 M_M, MCOPY_M2M, ID)
#include "riscv-ztt-types.def"
