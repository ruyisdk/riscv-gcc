/* Append the remaining
   UDS32 integer ACC variants without renumbering existing builtins.  */
#define ZTT_ACC_API(ID, NAME) \
  ZTT_INTRINSIC (MCLEAR_ACC_##ID##_ACCX1, \
                 "__riscv_ztt_mclear_acc_" #NAME "_accx1", \
                 A_VOID, ACLEAR, ID##_ACCX1) \
  ZTT_INTRINSIC (MZERO_ACC_##ID##_ACCX1, \
                 "__riscv_ztt_mzero_acc_" #NAME "_accx1", \
                 A_VOID, AZERO, ID##_ACCX1) \
  ZTT_INTRINSIC (MCOPY_M2A_##ID##_ACCX1, \
                 "__riscv_ztt_mcopy_m2a_" #NAME "_accx1", \
                 A_M, A_FROM_M, ID##_ACCX1) \
  ZTT_INTRINSIC (MCOPY_A2M_##ID##_1X1, \
                 "__riscv_ztt_mcopy_a2m_" #NAME "_1x1", \
                 M_A, M_FROM_A, ID##_ACCX1) \
  ZTT_INTRINSIC (MMULACC_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulacc_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMUL, ID##_ACCX1)
ZTT_ACC_API (I32_RNE, i32_rne)
ZTT_ACC_API (I32_RDN, i32_rdn)
ZTT_ACC_API (I32_ROD, i32_rod)
ZTT_ACC_API (U32_RNU, u32_rnu)
ZTT_ACC_API (U32_RNE, u32_rne)
ZTT_ACC_API (U32_RDN, u32_rdn)
ZTT_ACC_API (U32_ROD, u32_rod)

/* Append entries so
   existing builtin indices remain unchanged.  No mixed tuple is implied.  */
#define ZTT_ACC_VARIANTS(ID, NAME) \
  ZTT_INTRINSIC (MMULACCNEG_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulaccneg_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMULNEG, ID##_ACCX1) \
  ZTT_INTRINSIC (MMULATACC_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulatacc_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMULAT, ID##_ACCX1) \
  ZTT_INTRINSIC (MMULATACCNEG_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulataccneg_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMULATNEG, ID##_ACCX1) \
  ZTT_INTRINSIC (MMULBTACC_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulbtacc_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMULBT, ID##_ACCX1) \
  ZTT_INTRINSIC (MMULBTACCNEG_2D_##ID##_ACCX1, \
                 "__riscv_ztt_mmulbtaccneg_2d_" #NAME "_accx1", \
                 A_A_M_M, A_MMULBTNEG, ID##_ACCX1)
ZTT_ACC_VARIANTS (I32_RNU, i32_rnu)
ZTT_ACC_VARIANTS (I32_RNE, i32_rne)
ZTT_ACC_VARIANTS (I32_RDN, i32_rdn)
ZTT_ACC_VARIANTS (I32_ROD, i32_rod)
ZTT_ACC_VARIANTS (U32_RNU, u32_rnu)
ZTT_ACC_VARIANTS (U32_RNE, u32_rne)
ZTT_ACC_VARIANTS (U32_RDN, u32_rdn)
ZTT_ACC_VARIANTS (U32_ROD, u32_rod)

/* Append only;
   single-ACC registration rejects D < UDS; complete packed groups
   use the separate tuple copy entries below.  */
#define ZTT_ACC_WIDTH_RM(ID, NAME, RM, SUFFIX) \
  ZTT_ACC_API (ID##_##RM, NAME##_##SUFFIX) \
  ZTT_ACC_VARIANTS (ID##_##RM, NAME##_##SUFFIX)
#define ZTT_ACC_WIDTH(ID, NAME) \
  ZTT_ACC_WIDTH_RM (ID, NAME, RNU, rnu) \
  ZTT_ACC_WIDTH_RM (ID, NAME, RNE, rne) \
  ZTT_ACC_WIDTH_RM (ID, NAME, RDN, rdn) \
  ZTT_ACC_WIDTH_RM (ID, NAME, ROD, rod)
ZTT_ACC_WIDTH (I8, i8)
ZTT_ACC_WIDTH (U8, u8)
ZTT_ACC_WIDTH (I16, i16)
ZTT_ACC_WIDTH (U16, u16)
#undef ZTT_ACC_WIDTH
#undef ZTT_ACC_WIDTH_RM
#undef ZTT_ACC_API
#undef ZTT_ACC_VARIANTS

/* Append IDs.  The column
   m2a entry is an internal overload target, not another public API.  */
#define ZTT_ACC_COPY(ID, NAME, LEN, DESC, ALIAS, K) \
  ZTT_INTRINSIC (MCLEAR_ACC_##ID##_ACCX##K, \
                 "__riscv_ztt_mclear_acc_" #NAME "_accx" #K, \
                 A_VOID, ACLEAR, ID##_ACCX##K) \
  ZTT_INTRINSIC (MZERO_ACC_##ID##_ACCX##K, \
                 "__riscv_ztt_mzero_acc_" #NAME "_accx" #K, \
                 A_VOID, AZERO, ID##_ACCX##K) \
  ZTT_INTRINSIC (MCOPY_M2A_##ID##_ACCX##K, \
                 "__riscv_ztt_mcopy_m2a_" #NAME "_accx" #K, \
                 A_M, A_FROM_M, ID##_ACCX##K) \
  ZTT_INTRINSIC (MCOPY_M2A_COLUMN_##ID##_ACCX##K, \
                 "__builtin_riscv_ztt_mcopy_m2a_" #NAME "_accx" #K "_column", \
                 A_M_COLUMN, A_FROM_M, ID##_ACCX##K) \
  ZTT_INTRINSIC (MCOPY_A2M_##ID##_1X##K, \
                 "__riscv_ztt_mcopy_a2m_" #NAME "_1x" #K, \
                 M_A, M_FROM_A, ID##_ACCX##K) \
  ZTT_INTRINSIC (MCOPY_A2M_##ID##_##K##X1, \
                 "__riscv_ztt_mcopy_a2m_" #NAME "_" #K "x1", \
                 M_A_COLUMN, M_FROM_A, ID##_ACCX##K)
#define ZTT_ACC_TUPLE ZTT_ACC_COPY
#include "riscv-ztt-types.def"
#undef ZTT_ACC_TUPLE

/* Same-type 1x1 inputs;
   append IDs and preserve every unmodified old accumulator member.  */
#define ZTT_ACC_TUPLE_MUL(ID, NAME, K, STEM, SUFFIX, EXPANSION) \
  ZTT_INTRINSIC (STEM##_2D_##ID##_ACCX##K, \
                 "__riscv_ztt_" #SUFFIX "_2d_" #NAME "_accx" #K, \
                 A_A_M_M, EXPANSION, ID##_ACCX##K)
#define ZTT_ACC_TUPLE(ID, NAME, LEN, DESC, ALIAS, K) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULACC, mmulacc, A_MMUL) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULACCNEG, mmulaccneg, A_MMULNEG) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULATACC, mmulatacc, A_MMULAT) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULATACCNEG, mmulataccneg, A_MMULATNEG) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULBTACC, mmulbtacc, A_MMULBT) \
  ZTT_ACC_TUPLE_MUL (ID, NAME, K, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG)
#include "riscv-ztt-types.def"
#undef ZTT_ACC_TUPLE
#undef ZTT_ACC_TUPLE_MUL

/* Internal overload targets;
   public spellings and previous indices are unchanged.  Registration
   requires both the output type and the complete Q-Square M inputs.  */
#define ZTT_ACC_CONCAT_ENTRY(ID, NAME, STEM, SPELL, EXPAND, Q, DIR) \
  ZTT_INTRINSIC (STEM##_CONCAT_##ID##_Q##Q##_##DIR, \
                 "__builtin_riscv_ztt_" #SPELL "_2d_" #NAME "_q" #Q "_" #DIR, \
                 A_A_M_M_Q##Q##_##DIR, EXPAND, ID)
#define ZTT_ACC_CONCAT_Q(ID, NAME, Q) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULACC, mmulacc, A_MMUL, Q, RC) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULACCNEG, mmulaccneg, A_MMULNEG, Q, RC) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULATACC, mmulatacc, A_MMULAT, Q, RR) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULATACC, mmulatacc, A_MMULAT, Q, CC) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULATACCNEG, mmulataccneg, A_MMULATNEG, Q, RR) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULATACCNEG, mmulataccneg, A_MMULATNEG, Q, CC) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULBTACC, mmulbtacc, A_MMULBT, Q, RR) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULBTACC, mmulbtacc, A_MMULBT, Q, CC) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG, Q, RR) \
  ZTT_ACC_CONCAT_ENTRY (ID, NAME, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG, Q, CC)
#define ZTT_ACC_CONCAT_TYPE(ID, NAME) \
  ZTT_ACC_CONCAT_Q (ID, NAME, 2) \
  ZTT_ACC_CONCAT_Q (ID, NAME, 4)
#define ZTT_ACC_TYPE(ID, NAME, LEN, DESC, ALIAS) ZTT_ACC_CONCAT_TYPE (ID, NAME)
#include "riscv-ztt-types.def"
#undef ZTT_ACC_TYPE
#define ZTT_ACC_TUPLE(ID, NAME, LEN, DESC, ALIAS, K) \
  ZTT_ACC_CONCAT_TYPE (ID##_ACCX##K, NAME##_accx##K)
#include "riscv-ztt-types.def"
#undef ZTT_ACC_TUPLE
#undef ZTT_ACC_CONCAT_TYPE
#undef ZTT_ACC_CONCAT_Q
#undef ZTT_ACC_CONCAT_ENTRY

/* Append fixed IDs;
   registration requires both the source and result storage types.  */
#define ZTT_M_UTIL_PAIR(ID, NAME, BIG, BIG_NAME, SMALL, SMALL_NAME, PROTO, PREFIX) \
  ZTT_INTRINSIC (MCONCAT_##ID##_##BIG, \
                 "__riscv_ztt_mconcat_m_" #NAME "_" #BIG_NAME, \
                 M_CONCAT, MCONCAT, ID##_##BIG) \
  ZTT_INTRINSIC (MEXTRACT_##ID##_##BIG, \
                 PREFIX #NAME "_" #SMALL_NAME, \
                 PROTO, MEXTRACT, ID##_##SMALL)
#define ZTT_M_UTIL_TYPE(ID, NAME) \
  ZTT_M_UTIL_PAIR (ID, NAME, 1X2, 1x2, 1X1, 1x1, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 2X1, 2x1, 1X1, 1x1, M_EXTRACT_COLUMN, "__builtin_riscv_ztt_mextract_column_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 1X4, 1x4, 1X2, 1x2, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 4X1, 4x1, 2X1, 2x1, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 1X8, 1x8, 1X4, 1x4, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 8X1, 8x1, 4X1, 4x1, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 1X16, 1x16, 1X8, 1x8, M_EXTRACT, "__riscv_ztt_mextract_") \
  ZTT_M_UTIL_PAIR (ID, NAME, 16X1, 16x1, 8X1, 8x1, M_EXTRACT, "__riscv_ztt_mextract_")
#define ZTT_M_UTIL_RM(ID, NAME, RM, LOWER) ZTT_M_UTIL_TYPE (ID##_##RM, NAME##_##LOWER)
#define ZTT_M_UTIL_INT(ID, NAME) \
  ZTT_M_UTIL_RM (ID, NAME, RNU, rnu) \
  ZTT_M_UTIL_RM (ID, NAME, RNE, rne) \
  ZTT_M_UTIL_RM (ID, NAME, RDN, rdn) \
  ZTT_M_UTIL_RM (ID, NAME, ROD, rod)
ZTT_M_UTIL_INT (I8, i8)
ZTT_M_UTIL_INT (U8, u8)
ZTT_M_UTIL_INT (I16, i16)
ZTT_M_UTIL_INT (U16, u16)
ZTT_M_UTIL_INT (I32, i32)
ZTT_M_UTIL_INT (U32, u32)
#undef ZTT_M_UTIL_INT
#undef ZTT_M_UTIL_RM
#undef ZTT_M_UTIL_TYPE
#undef ZTT_M_UTIL_PAIR

/* Append after every old
   fixed ID; new types do not gain matmul entries or aliases.  */
#define ZTT_ACC_LARGE ZTT_ACC_COPY
#include "riscv-ztt-types.def"
#undef ZTT_ACC_LARGE
#undef ZTT_ACC_COPY

/* Append large output anchors;
   exact source overloads are registered lazily, not as a Cartesian product.  */
#define ZTT_ACC_LARGE_MUL(ID, NAME, K, STEM, SPELL, EXPAND) \
  ZTT_INTRINSIC (STEM##_2D_##ID##_ACCX##K, \
                 "__riscv_ztt_" #SPELL "_2d_" #NAME "_accx" #K, \
                 A_A_M_M, EXPAND, ID##_ACCX##K)
#define ZTT_ACC_LARGE(ID, NAME, LEN, DESC, ALIAS, K) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULACC, mmulacc, A_MMUL) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULACCNEG, mmulaccneg, A_MMULNEG) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULATACC, mmulatacc, A_MMULAT) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULATACCNEG, mmulataccneg, A_MMULATNEG) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULBTACC, mmulbtacc, A_MMULBT) \
  ZTT_ACC_LARGE_MUL (ID, NAME, K, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG)
#include "riscv-ztt-types.def"
#undef ZTT_ACC_LARGE
#undef ZTT_ACC_LARGE_MUL

/* Arguments (a,b)
   produce b-a.  Append after old IDs; exact same T/RM/shape only.  */
#define ZTT_SUB(ID, NAME) \
  ZTT_INTRINSIC (MSUB_EW_##ID, "__riscv_ztt_msub_ew_" #NAME, \
                 M_M_M, MSUB_EW, ID)
