/* Append to preserve
   existing builtin codes; only legal profile/type combinations register.  */
#define ZTT_M_SHAPE(ID, NAME, MANGLED, DESC, ALIAS, ROWS, COLS) \
  ZTT_INTRINSIC (MCLEAR_M_##ID, "__riscv_ztt_mclear_m_" #NAME, \
                 M_VOID, MCLEAR_M, ID) \
  ZTT_INTRINSIC (MZERO_M_##ID, "__riscv_ztt_mzero_m_" #NAME, \
                 M_VOID, MZERO_2D_M, ID) \
  ZTT_INTRINSIC (MLS_RM_##ID, "__riscv_ztt_mls_rm_" #NAME, \
                 M_CONST_PTR, MLS_RM, ID) \
  ZTT_INTRINSIC (MSS_RM_##ID, "__riscv_ztt_mss_rm_" #NAME, \
                 VOID_PTR_M, MSS_RM, ID) \
  ZTT_INTRINSIC (MADD_EW_##ID, "__riscv_ztt_madd_ew_" #NAME, \
                 M_M_M, MADD_EW, ID)
#include "riscv-ztt-types.def"
#undef ZTT_M_SHAPE

