#undef ZTT_TERNARY_X_OP
#undef ZTT_TERNARY_X_RMS
#undef ZTT_TERNARY_X_TYPE
#undef ZTT_TERNARY_X_SHAPE
#undef ZTT_TERNARY_X_SOURCE
