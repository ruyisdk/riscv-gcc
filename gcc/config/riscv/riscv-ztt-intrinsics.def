#define ZTT_M_SHAPE(ID, NAME, MANGLED, DESC, ALIAS, ROWS, COLS) ZTT_SUB (ID, NAME)
#include "riscv-ztt-types.def"
#undef ZTT_M_SHAPE
#undef ZTT_SUB

/* Identical source/result
   datatype, signedness, RM and shape; append without renumbering old IDs.  */
