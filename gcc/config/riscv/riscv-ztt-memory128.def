/* 128-bit storage elements, not ordinary C integer arithmetic.  */

/* Operation groups preserve the existing catalog order and builtin codes.  */
#define ZTT_MEMORY128_TYPE(TYPE, NAME) \
  ZTT_INTRINSIC (MLS_RM##_##TYPE, "__riscv_ztt_mls_rm_" #NAME, \
		 M_CONST_PTR, MLS_RM, TYPE) \
  ZTT_INTRINSIC (MSS_RM##_##TYPE, "__riscv_ztt_mss_rm_" #NAME, \
		 VOID_PTR_M, MSS_RM, TYPE) \
  ZTT_INTRINSIC (MLS_CM##_##TYPE, "__riscv_ztt_mls_cm_" #NAME, \
		 M_CONST_PTR, MLS_CM, TYPE) \
  ZTT_INTRINSIC (MSS_CM##_##TYPE, "__riscv_ztt_mss_cm_" #NAME, \
		 VOID_PTR_M, MSS_CM, TYPE) \
  ZTT_INTRINSIC (MLS_ST##_##TYPE, "__riscv_ztt_mls_st_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_ST, TYPE) \
  ZTT_INTRINSIC (MSS_ST##_##TYPE, "__riscv_ztt_mss_st_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_ST, TYPE) \
  ZTT_INTRINSIC (MLS_TST##_##TYPE, "__riscv_ztt_mls_tst_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_TST, TYPE) \
  ZTT_INTRINSIC (MSS_TST##_##TYPE, "__riscv_ztt_mss_tst_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_TST, TYPE)

