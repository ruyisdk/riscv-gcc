/* Nibble/saturating ACC result anchors;
   source types and shapes resolve lazily without renumbering old entries.  */
#define ZTT_INT_MATMUL_ENTRY(ID, NAME, K, OP, SPELL, EXPAND) \
  ZTT_INTRINSIC (OP##_2D_##ID##_ACCX##K, \
                 "__riscv_ztt_" #SPELL "_2d_" #NAME "_accx" #K, \
                 A_A_M_M, EXPAND, ID##_ACCX##K)
#define ZTT_INT_MATMUL_K(ID, NAME, K) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULACC, mmulacc, A_MMUL) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULACCNEG, mmulaccneg, A_MMULNEG) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULATACC, mmulatacc, A_MMULAT) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULATACCNEG, mmulataccneg, A_MMULATNEG) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULBTACC, mmulbtacc, A_MMULBT) \
  ZTT_INT_MATMUL_ENTRY (ID, NAME, K, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG)
#define ZTT_INT_MATMUL_TYPE(ID, NAME) \
  ZTT_INT_MATMUL_K (ID, NAME, 1) \
  ZTT_INT_MATMUL_K (ID, NAME, 2) \
  ZTT_INT_MATMUL_K (ID, NAME, 4) \
  ZTT_INT_MATMUL_K (ID, NAME, 8) \
  ZTT_INT_MATMUL_K (ID, NAME, 16)
