/* Saturation is datatype identity, not a separate physical storage mode.  */

#include "riscv-ztt-catalog-iterators.h"

/* Shape-specific operation groups retain the original builtin order.
   Q32 has no larger input for extract; 1x1 has a column extractor.  */
#define ZTT_INT_VALUES_SINGLE(TYPE, NAME, MEMORY) \
  ZTT_INTRINSIC (MCLEAR_M##_##TYPE, "__riscv_ztt_mclear_m_" #NAME, \
		 M_VOID, MCLEAR_M, TYPE) \
  ZTT_INTRINSIC (MZERO_M##_##TYPE, "__riscv_ztt_mzero_m_" #NAME, \
		 M_VOID, MZERO_2D_M, TYPE) \
  ZTT_INTRINSIC (MCOPY_M2M##_##TYPE, "__riscv_ztt_mcopy_m2m_" #NAME, \
		 M_M, MCOPY_M2M, TYPE) \
  ZTT_INTRINSIC (MEXTRACT##_##TYPE, "__riscv_ztt_mextract_" #NAME, \
		 M_EXTRACT, MEXTRACT, TYPE) \
  ZTT_INTRINSIC (MEXTRACT_COLUMN##_##TYPE, "__builtin_riscv_ztt_mextract_column_" #NAME, \
		 M_EXTRACT_COLUMN, MEXTRACT, TYPE) \
  ZTT_INTRINSIC (MCONV_EW##_##TYPE, "__riscv_ztt_mconv_ew_" #NAME, \
		 M_CONVERT, MCONV_EW, TYPE) \
  ZTT_INTRINSIC (MABS_EW##_##TYPE, "__riscv_ztt_mabs_ew_" #NAME, \
		 M_ABS, MABS_EW, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_COL##_##TYPE, "__riscv_ztt_mreduceadd_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_ROW##_##TYPE, "__riscv_ztt_mreduceadd_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_COL##_##TYPE, "__riscv_ztt_mreducemax_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_ROW##_##TYPE, "__riscv_ztt_mreducemax_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_COL##_##TYPE, "__riscv_ztt_mreducemin_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_ROW##_##TYPE, "__riscv_ztt_mreducemin_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_COL##_##TYPE, "__riscv_ztt_mprefixadd_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_ROW##_##TYPE, "__riscv_ztt_mprefixadd_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_COL##_##TYPE, "__riscv_ztt_mprefixmax_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_ROW##_##TYPE, "__riscv_ztt_mprefixmax_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_ROW, TYPE) \
  MEMORY (TYPE, NAME)

#define ZTT_INT_VALUES_GROUP(TYPE, NAME, MEMORY) \
  ZTT_INTRINSIC (MCLEAR_M##_##TYPE, "__riscv_ztt_mclear_m_" #NAME, \
		 M_VOID, MCLEAR_M, TYPE) \
  ZTT_INTRINSIC (MZERO_M##_##TYPE, "__riscv_ztt_mzero_m_" #NAME, \
		 M_VOID, MZERO_2D_M, TYPE) \
  ZTT_INTRINSIC (MCOPY_M2M##_##TYPE, "__riscv_ztt_mcopy_m2m_" #NAME, \
		 M_M, MCOPY_M2M, TYPE) \
  ZTT_INTRINSIC (MCONCAT##_##TYPE, "__riscv_ztt_mconcat_m_" #NAME, \
		 M_CONCAT, MCONCAT, TYPE) \
  ZTT_INTRINSIC (MEXTRACT##_##TYPE, "__riscv_ztt_mextract_" #NAME, \
		 M_EXTRACT, MEXTRACT, TYPE) \
  ZTT_INTRINSIC (MCONV_EW##_##TYPE, "__riscv_ztt_mconv_ew_" #NAME, \
		 M_CONVERT, MCONV_EW, TYPE) \
  ZTT_INTRINSIC (MABS_EW##_##TYPE, "__riscv_ztt_mabs_ew_" #NAME, \
		 M_ABS, MABS_EW, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_COL##_##TYPE, "__riscv_ztt_mreduceadd_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_ROW##_##TYPE, "__riscv_ztt_mreduceadd_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_COL##_##TYPE, "__riscv_ztt_mreducemax_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_ROW##_##TYPE, "__riscv_ztt_mreducemax_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_COL##_##TYPE, "__riscv_ztt_mreducemin_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_ROW##_##TYPE, "__riscv_ztt_mreducemin_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_COL##_##TYPE, "__riscv_ztt_mprefixadd_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_ROW##_##TYPE, "__riscv_ztt_mprefixadd_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_COL##_##TYPE, "__riscv_ztt_mprefixmax_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_ROW##_##TYPE, "__riscv_ztt_mprefixmax_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_ROW, TYPE) \
  MEMORY (TYPE, NAME)

#define ZTT_INT_VALUES_Q32(TYPE, NAME, MEMORY) \
  ZTT_INTRINSIC (MCLEAR_M##_##TYPE, "__riscv_ztt_mclear_m_" #NAME, \
		 M_VOID, MCLEAR_M, TYPE) \
  ZTT_INTRINSIC (MZERO_M##_##TYPE, "__riscv_ztt_mzero_m_" #NAME, \
		 M_VOID, MZERO_2D_M, TYPE) \
  ZTT_INTRINSIC (MCOPY_M2M##_##TYPE, "__riscv_ztt_mcopy_m2m_" #NAME, \
		 M_M, MCOPY_M2M, TYPE) \
  ZTT_INTRINSIC (MCONCAT##_##TYPE, "__riscv_ztt_mconcat_m_" #NAME, \
		 M_CONCAT, MCONCAT, TYPE) \
  ZTT_INTRINSIC (MCONV_EW##_##TYPE, "__riscv_ztt_mconv_ew_" #NAME, \
		 M_CONVERT, MCONV_EW, TYPE) \
  ZTT_INTRINSIC (MABS_EW##_##TYPE, "__riscv_ztt_mabs_ew_" #NAME, \
		 M_ABS, MABS_EW, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_COL##_##TYPE, "__riscv_ztt_mreduceadd_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEADD_ROW##_##TYPE, "__riscv_ztt_mreduceadd_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEADD_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_COL##_##TYPE, "__riscv_ztt_mreducemax_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMAX_ROW##_##TYPE, "__riscv_ztt_mreducemax_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMAX_ROW, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_COL##_##TYPE, "__riscv_ztt_mreducemin_col_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_COL, TYPE) \
  ZTT_INTRINSIC (MREDUCEMIN_ROW##_##TYPE, "__riscv_ztt_mreducemin_row_" #NAME, \
		 M_STRUCTURAL, MREDUCEMIN_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_COL##_##TYPE, "__riscv_ztt_mprefixadd_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXADD_ROW##_##TYPE, "__riscv_ztt_mprefixadd_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXADD_ROW, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_COL##_##TYPE, "__riscv_ztt_mprefixmax_col_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_COL, TYPE) \
  ZTT_INTRINSIC (MPREFIXMAX_ROW##_##TYPE, "__riscv_ztt_mprefixmax_row_" #NAME, \
		 M_STRUCTURAL, MPREFIXMAX_ROW, TYPE) \
  MEMORY (TYPE, NAME)

/* i4 has no memory API.  The 128-bit storage API is appended in
   memory128.def, rather than inserted into this historic block.  */
#define ZTT_INT_VALUES_MEMORY(TYPE, NAME) \
  ZTT_INTRINSIC (MLS_RM##_##TYPE, "__riscv_ztt_mls_rm_" #NAME, \
		 M_CONST_PTR, MLS_RM, TYPE) \
  ZTT_INTRINSIC (MSS_RM##_##TYPE, "__riscv_ztt_mss_rm_" #NAME, \
		 VOID_PTR_M, MSS_RM, TYPE) \
  ZTT_INTRINSIC (MLS_CM##_##TYPE, "__riscv_ztt_mls_cm_" #NAME, \
		 M_CONST_PTR, MLS_CM, TYPE) \
  ZTT_INTRINSIC (MSS_CM##_##TYPE, "__riscv_ztt_mss_cm_" #NAME, \
		 VOID_PTR_M, MSS_CM, TYPE) \
  ZTT_INTRINSIC (MLS_ST##_##TYPE, "__riscv_ztt_mls_st_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_ST, TYPE) \
  ZTT_INTRINSIC (MSS_ST##_##TYPE, "__riscv_ztt_mss_st_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_ST, TYPE) \
  ZTT_INTRINSIC (MLS_TST##_##TYPE, "__riscv_ztt_mls_tst_" #NAME, \
		 M_CONST_PTR_STRIDE, MLS_TST, TYPE) \
  ZTT_INTRINSIC (MSS_TST##_##TYPE, "__riscv_ztt_mss_tst_" #NAME, \
		 VOID_PTR_STRIDE_M, MSS_TST, TYPE)

#define ZTT_INT_VALUES_NO_MEMORY(TYPE, NAME)

/* ACC-to-M public shapes differ from the ACC type operand.  Keep
   these mappings explicit, including internal column names.  */
#define ZTT_INT_VALUES_ACC(TYPE, NAME) \
  ZTT_INTRINSIC (MCLEAR_ACC_##TYPE##_ACCX1, \
		 "__riscv_ztt_mclear_acc_" #NAME "_accx1", \
		 A_VOID, ACLEAR, TYPE##_ACCX1) \
  ZTT_INTRINSIC (MZERO_ACC_##TYPE##_ACCX1, \
		 "__riscv_ztt_mzero_acc_" #NAME "_accx1", \
		 A_VOID, AZERO, TYPE##_ACCX1) \
  ZTT_INTRINSIC (MCOPY_M2A_##TYPE##_ACCX1, \
		 "__riscv_ztt_mcopy_m2a_" #NAME "_accx1", \
		 A_M, A_FROM_M, TYPE##_ACCX1) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_1X1, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_1x1", \
		 M_A, M_FROM_A, TYPE##_ACCX1) \
  ZTT_INTRINSIC (MCLEAR_ACC_##TYPE##_ACCX2, \
		 "__riscv_ztt_mclear_acc_" #NAME "_accx2", \
		 A_VOID, ACLEAR, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MZERO_ACC_##TYPE##_ACCX2, \
		 "__riscv_ztt_mzero_acc_" #NAME "_accx2", \
		 A_VOID, AZERO, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MCOPY_M2A_##TYPE##_ACCX2, \
		 "__riscv_ztt_mcopy_m2a_" #NAME "_accx2", \
		 A_M, A_FROM_M, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_1X2, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_1x2", \
		 M_A, M_FROM_A, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MCOPY_M2A_COLUMN_##TYPE##_ACCX2, \
		 "__builtin_riscv_ztt_mcopy_m2a_" #NAME "_accx2_column", \
		 A_M_COLUMN, A_FROM_M, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_2X1, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_2x1", \
		 M_A_COLUMN, M_FROM_A, TYPE##_ACCX2) \
  ZTT_INTRINSIC (MCLEAR_ACC_##TYPE##_ACCX4, \
		 "__riscv_ztt_mclear_acc_" #NAME "_accx4", \
		 A_VOID, ACLEAR, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MZERO_ACC_##TYPE##_ACCX4, \
		 "__riscv_ztt_mzero_acc_" #NAME "_accx4", \
		 A_VOID, AZERO, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MCOPY_M2A_##TYPE##_ACCX4, \
		 "__riscv_ztt_mcopy_m2a_" #NAME "_accx4", \
		 A_M, A_FROM_M, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_1X4, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_1x4", \
		 M_A, M_FROM_A, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MCOPY_M2A_COLUMN_##TYPE##_ACCX4, \
		 "__builtin_riscv_ztt_mcopy_m2a_" #NAME "_accx4_column", \
		 A_M_COLUMN, A_FROM_M, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_4X1, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_4x1", \
		 M_A_COLUMN, M_FROM_A, TYPE##_ACCX4) \
  ZTT_INTRINSIC (MCLEAR_ACC_##TYPE##_ACCX8, \
		 "__riscv_ztt_mclear_acc_" #NAME "_accx8", \
		 A_VOID, ACLEAR, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MZERO_ACC_##TYPE##_ACCX8, \
		 "__riscv_ztt_mzero_acc_" #NAME "_accx8", \
		 A_VOID, AZERO, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MCOPY_M2A_##TYPE##_ACCX8, \
		 "__riscv_ztt_mcopy_m2a_" #NAME "_accx8", \
		 A_M, A_FROM_M, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_1X8, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_1x8", \
		 M_A, M_FROM_A, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MCOPY_M2A_COLUMN_##TYPE##_ACCX8, \
		 "__builtin_riscv_ztt_mcopy_m2a_" #NAME "_accx8_column", \
		 A_M_COLUMN, A_FROM_M, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_8X1, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_8x1", \
		 M_A_COLUMN, M_FROM_A, TYPE##_ACCX8) \
  ZTT_INTRINSIC (MCLEAR_ACC_##TYPE##_ACCX16, \
		 "__riscv_ztt_mclear_acc_" #NAME "_accx16", \
		 A_VOID, ACLEAR, TYPE##_ACCX16) \
  ZTT_INTRINSIC (MZERO_ACC_##TYPE##_ACCX16, \
		 "__riscv_ztt_mzero_acc_" #NAME "_accx16", \
		 A_VOID, AZERO, TYPE##_ACCX16) \
  ZTT_INTRINSIC (MCOPY_M2A_##TYPE##_ACCX16, \
		 "__riscv_ztt_mcopy_m2a_" #NAME "_accx16", \
		 A_M, A_FROM_M, TYPE##_ACCX16) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_1X16, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_1x16", \
		 M_A, M_FROM_A, TYPE##_ACCX16) \
  ZTT_INTRINSIC (MCOPY_M2A_COLUMN_##TYPE##_ACCX16, \
		 "__builtin_riscv_ztt_mcopy_m2a_" #NAME "_accx16_column", \
		 A_M_COLUMN, A_FROM_M, TYPE##_ACCX16) \
  ZTT_INTRINSIC (MCOPY_A2M_##TYPE##_16X1, \
		 "__riscv_ztt_mcopy_a2m_" #NAME "_16x1", \
		 M_A_COLUMN, M_FROM_A, TYPE##_ACCX16)

#define ZTT_INT_VALUES_TYPE(TYPE, NAME, MEMORY) \
  ZTT_INT_VALUES_SINGLE (TYPE##_1X1, NAME##_1x1, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_1X2, NAME##_1x2, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_2X1, NAME##_2x1, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_1X4, NAME##_1x4, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_4X1, NAME##_4x1, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_1X8, NAME##_1x8, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_8X1, NAME##_8x1, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_1X16, NAME##_1x16, MEMORY) \
  ZTT_INT_VALUES_GROUP (TYPE##_16X1, NAME##_16x1, MEMORY) \
  ZTT_INT_VALUES_Q32 (TYPE##_1X32, NAME##_1x32, MEMORY) \
  ZTT_INT_VALUES_Q32 (TYPE##_32X1, NAME##_32x1, MEMORY) \
  ZTT_INT_VALUES_ACC (TYPE, NAME)

/* Datatype-major order.  Do not replace the integer sequence with
   the all-types axis: earlier catalog blocks already own some types.  */
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U4, u4,
		     , , ZTT_INT_VALUES_NO_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I4, i4,
		     , , ZTT_INT_VALUES_NO_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U4, u4,
		     _SAT, _sat, ZTT_INT_VALUES_NO_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I4, i4,
		     _SAT, _sat, ZTT_INT_VALUES_NO_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U8, u8,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I8, i8,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U16, u16,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I16, i16,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U32, u32,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I32, i32,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U64, u64,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I64, i64,
		     _SAT, _sat, ZTT_INT_VALUES_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, U128, u128,
		     _SAT, _sat, ZTT_INT_VALUES_NO_MEMORY)
ZTT_CATALOG_INT_RMS (ZTT_INT_VALUES_TYPE, I128, i128,
		     _SAT, _sat, ZTT_INT_VALUES_NO_MEMORY)

#undef ZTT_INT_VALUES_SINGLE
#undef ZTT_INT_VALUES_GROUP
#undef ZTT_INT_VALUES_Q32
#undef ZTT_INT_VALUES_MEMORY
#undef ZTT_INT_VALUES_NO_MEMORY
#undef ZTT_INT_VALUES_ACC
#undef ZTT_INT_VALUES_TYPE

/* Integer-kind result anchors; mixed metadata is carried by constant operands.  */

/* Operation groups preserve the existing catalog order and builtin codes.  */
#define ZTT_INT_MATRIX_SINGLE(TYPE, NAME) \
  ZTT_INTRINSIC (MADD_EW##_##TYPE, "__riscv_ztt_madd_ew_" #NAME, \
		 M_M_M, MADD_EW, TYPE) \
  ZTT_INTRINSIC (MSUB_EW##_##TYPE, "__riscv_ztt_msub_ew_" #NAME, \
		 M_M_M, MSUB_EW, TYPE) \
  ZTT_INTRINSIC (MMUL_EW##_##TYPE, "__riscv_ztt_mmul_ew_" #NAME, \
		 M_BINARY_M, MMUL_EW, TYPE) \
  ZTT_INTRINSIC (MMULNEG_EW##_##TYPE, "__riscv_ztt_mmulneg_ew_" #NAME, \
		 M_BINARY_M, MMULNEG_EW, TYPE) \
  ZTT_INTRINSIC (MABSDIFF_EW##_##TYPE, "__riscv_ztt_mabsdiff_ew_" #NAME, \
		 M_BINARY_M, MABSDIFF_EW, TYPE) \
  ZTT_INTRINSIC (MHDIFF_EW##_##TYPE, "__riscv_ztt_mhdiff_ew_" #NAME, \
		 M_BINARY_M, MHDIFF_EW, TYPE) \
  ZTT_INTRINSIC (MMEAN_EW##_##TYPE, "__riscv_ztt_mmean_ew_" #NAME, \
		 M_BINARY_M, MMEAN_EW, TYPE) \
  ZTT_INTRINSIC (MCMPGE_EW##_##TYPE, "__riscv_ztt_mcmpge_ew_" #NAME, \
		 M_BINARY_M, MCMPGE_EW, TYPE) \
  ZTT_INTRINSIC (MCMPLT_EW##_##TYPE, "__riscv_ztt_mcmplt_ew_" #NAME, \
		 M_BINARY_M, MCMPLT_EW, TYPE) \
  ZTT_INTRINSIC (MSELGE_EW##_##TYPE, "__riscv_ztt_mselge_ew_" #NAME, \
		 M_BINARY_M, MSELGE_EW, TYPE) \
  ZTT_INTRINSIC (MSELLT_EW##_##TYPE, "__riscv_ztt_msellt_ew_" #NAME, \
		 M_BINARY_M, MSELLT_EW, TYPE) \
  ZTT_INTRINSIC (MSLL_EW##_##TYPE, "__riscv_ztt_msll_ew_" #NAME, \
		 M_SHIFT_M, MSLL_EW, TYPE) \
  ZTT_INTRINSIC (MSLL_EW_X##_##TYPE, "__riscv_ztt_msll_ew_x_" #NAME, \
		 M_SHIFT_X, MSLL_EW_X, TYPE) \
  ZTT_INTRINSIC (MSRL_EW##_##TYPE, "__riscv_ztt_msrl_ew_" #NAME, \
		 M_SHIFT_M, MSRL_EW, TYPE) \
  ZTT_INTRINSIC (MSRL_EW_X##_##TYPE, "__riscv_ztt_msrl_ew_x_" #NAME, \
		 M_SHIFT_X, MSRL_EW_X, TYPE) \
  ZTT_INTRINSIC (MSRA_EW##_##TYPE, "__riscv_ztt_msra_ew_" #NAME, \
		 M_SHIFT_M, MSRA_EW, TYPE) \
  ZTT_INTRINSIC (MSRA_EW_X##_##TYPE, "__riscv_ztt_msra_ew_x_" #NAME, \
		 M_SHIFT_X, MSRA_EW_X, TYPE) \
  ZTT_INTRINSIC (MMULACC_EW##_##TYPE, "__riscv_ztt_mmulacc_ew_" #NAME, \
