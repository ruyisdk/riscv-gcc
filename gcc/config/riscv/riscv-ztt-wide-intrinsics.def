/* Wide matrix result anchors;
   mixed source declarations remain lazy.  */

#define ZTT_WIDE_MATRIX_ENTRY(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, SHAPE, SHAPENAME) \
  ZTT_INTRINSIC (OP##_##ID##_##RM##_##SHAPE, \
                 "__riscv_ztt_" #NAME "_" #TYPE "_" #SUFFIX "_" #SHAPENAME, \
                 PROTO, OP, ID##_##RM##_##SHAPE)
#define ZTT_WIDE_MATRIX_SHAPES_0(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X1, 1x1) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X2, 1x2) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 2X1, 2x1) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X4, 1x4) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 4X1, 4x1) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X8, 1x8) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 8X1, 8x1) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X16, 1x16) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 16X1, 16x1) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X32, 1x32) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 32X1, 32x1)
#define ZTT_WIDE_MATRIX_SHAPES_1(OP, NAME, PROTO, ID, TYPE, RM, SUFFIX) \
  ZTT_WIDE_MATRIX_ENTRY (OP, NAME, PROTO, ID, TYPE, RM, SUFFIX, 1X1, 1x1)
#define ZTT_WIDE_MATRIX_RMS(OP, NAME, PROTO, BASIC, ID, TYPE) \
  ZTT_WIDE_MATRIX_SHAPES_##BASIC (OP, NAME, PROTO, ID, TYPE, RNU, rnu) \
  ZTT_WIDE_MATRIX_SHAPES_##BASIC (OP, NAME, PROTO, ID, TYPE, RNE, rne) \
  ZTT_WIDE_MATRIX_SHAPES_##BASIC (OP, NAME, PROTO, ID, TYPE, RDN, rdn) \
  ZTT_WIDE_MATRIX_SHAPES_##BASIC (OP, NAME, PROTO, ID, TYPE, ROD, rod)
#define ZTT_WIDE_OP(OP, NAME, PROTO, BASIC) \
  ZTT_WIDE_MATRIX_RMS (OP, NAME, PROTO, BASIC, I64, i64) \
  ZTT_WIDE_MATRIX_RMS (OP, NAME, PROTO, BASIC, U64, u64) \
  ZTT_WIDE_MATRIX_RMS (OP, NAME, PROTO, BASIC, I128, i128) \
  ZTT_WIDE_MATRIX_RMS (OP, NAME, PROTO, BASIC, U128, u128)

#include "riscv-ztt-operations.def"

ZTT_WIDE_OP (MMIN_EW, mmin_ew, M_M_M, 0)
ZTT_WIDE_OP (MMAX_EW, mmax_ew, M_M_M, 0)
ZTT_WIDE_OP (MAND_EW, mand_ew, M_M_M, 0)
ZTT_WIDE_OP (MANDNOT_EW, mandnot_ew, M_M_M, 0)
ZTT_WIDE_OP (MOR_EW, mor_ew, M_M_M, 0)
ZTT_WIDE_OP (MORNOT_EW, mornot_ew, M_M_M, 0)
ZTT_WIDE_OP (MXOR_EW, mxor_ew, M_M_M, 0)
ZTT_WIDE_OP (MCOLBCAST_EW_X, mcolbcast_ew_x, M_ROWCOL_INDEX, 1)
ZTT_WIDE_OP (MROWBCAST_EW_X, mrowbcast_ew_x, M_ROWCOL_INDEX, 1)
ZTT_WIDE_OP (MCOLSHIFT_EW_X, mcolshift_ew_x, M_ROWCOL_OFFSET, 1)
ZTT_WIDE_OP (MROWSHIFT_EW_X, mrowshift_ew_x, M_ROWCOL_OFFSET, 1)
ZTT_WIDE_OP (MCOLZIP_EW, mcolzip_ew, VOID_MPTR_MPTR, 1)
ZTT_WIDE_OP (MROWZIP_EW, mrowzip_ew, VOID_MPTR_MPTR, 1)
ZTT_WIDE_OP (MCOLUNZIP_EW, mcolunzip_ew, VOID_MPTR_MPTR, 1)
ZTT_WIDE_OP (MROWUNZIP_EW, mrowunzip_ew, VOID_MPTR_MPTR, 1)
ZTT_WIDE_OP (MROWID_EW, mrowid_ew, M_VOID, 1)
ZTT_WIDE_OP (MCOLID_EW, mcolid_ew, M_VOID, 1)

#undef ZTT_WIDE_OP
#undef ZTT_WIDE_MATRIX_RMS
#undef ZTT_WIDE_MATRIX_SHAPES_1
#undef ZTT_WIDE_MATRIX_SHAPES_0
#undef ZTT_WIDE_MATRIX_ENTRY

/* Append anchors with a wide destination or scalar type.  Matrix source
   datatypes are resolved lazily.  TC greater than XLEN uses an X carrier.  */

#define ZTT_WSC_ENTRY(OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN, CM, CR) \
  ZTT_INTRINSIC (OP##_##D##_##RM##_##S##_##C##_##CM, \
                 "__riscv_ztt_" #NAME "_" #DN "_" #RN "_" #SN "_" #CN "_" #CR, \
                 KIND##_##C##_##CM, OP, D##_##RM##_##S)
#define ZTT_WSC_TC(OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN) \
  ZTT_WSC_ENTRY (OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN, RNU, rnu) \
  ZTT_WSC_ENTRY (OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN, RNE, rne) \
  ZTT_WSC_ENTRY (OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN, RDN, rdn) \
  ZTT_WSC_ENTRY (OP, NAME, KIND, D, DN, RM, RN, S, SN, C, CN, ROD, rod)
#define ZTT_WSC_TC_ALL(OP, NAME, KIND, D, DN, RM, RN, S, SN) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I8, i8) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U8, u8) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I16, i16) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U16, u16) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I32, i32) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U32, u32) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I64, i64) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U64, u64) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I128, i128) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U128, u128)
#define ZTT_WSC_TC_WIDE(OP, NAME, KIND, D, DN, RM, RN, S, SN) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I64, i64) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U64, u64) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, I128, i128) \
  ZTT_WSC_TC (OP, NAME, KIND, D, DN, RM, RN, S, SN, U128, u128)
#define ZTT_WSC_SHAPES(OP, NAME, KIND, D, DN, RM, RN, SET) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X1, 1x1) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X2, 1x2) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 2X1, 2x1) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X4, 1x4) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 4X1, 4x1) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X8, 1x8) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 8X1, 8x1) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X16, 1x16) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 16X1, 16x1) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 1X32, 1x32) \
  ZTT_WSC_TC_##SET (OP, NAME, KIND, D, DN, RM, RN, 32X1, 32x1)
#define ZTT_WSC_TYPE(OP, NAME, KIND, D, DN, SET) \
  ZTT_WSC_SHAPES (OP, NAME, KIND, D, DN, RNU, rnu, SET) \
  ZTT_WSC_SHAPES (OP, NAME, KIND, D, DN, RNE, rne, SET) \
  ZTT_WSC_SHAPES (OP, NAME, KIND, D, DN, RDN, rdn, SET) \
  ZTT_WSC_SHAPES (OP, NAME, KIND, D, DN, ROD, rod, SET)
#define ZTT_WSC_OPERATION(OP, NAME, KIND) \
  ZTT_WSC_TYPE (OP, NAME, KIND, I8, i8, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, U8, u8, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, I16, i16, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, U16, u16, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, I32, i32, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, U32, u32, WIDE) \
  ZTT_WSC_TYPE (OP, NAME, KIND, I64, i64, ALL) \
  ZTT_WSC_TYPE (OP, NAME, KIND, U64, u64, ALL) \
  ZTT_WSC_TYPE (OP, NAME, KIND, I128, i128, ALL) \
  ZTT_WSC_TYPE (OP, NAME, KIND, U128, u128, ALL)

#define ZTT_WIDE_SCALAR_OP(OP, NAME, KIND) \
  ZTT_WSC_OPERATION (OP, NAME, M_##KIND)
#include "riscv-ztt-operations.def"
#undef ZTT_WIDE_SCALAR_OP
ZTT_WSC_OPERATION (MBCAST_M_X, mbcast_m_x, M_BCAST)

#undef ZTT_WSC_OPERATION
#undef ZTT_WSC_TYPE
#undef ZTT_WSC_SHAPES
#undef ZTT_WSC_TC_WIDE
#undef ZTT_WSC_TC_ALL
#undef ZTT_WSC_TC
#undef ZTT_WSC_ENTRY

/* Wide ACC result anchors;
   source types and shapes resolve lazily without renumbering old entries.  */
#define ZTT_WIDE_MATMUL_ENTRY(ID, NAME, K, OP, SPELL, EXPAND) \
  ZTT_INTRINSIC (OP##_2D_##ID##_ACCX##K, \
                 "__riscv_ztt_" #SPELL "_2d_" #NAME "_accx" #K, \
                 A_A_M_M, EXPAND, ID##_ACCX##K)
#define ZTT_WIDE_MATMUL_K(ID, NAME, K) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULACC, mmulacc, A_MMUL) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULACCNEG, mmulaccneg, A_MMULNEG) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULATACC, mmulatacc, A_MMULAT) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULATACCNEG, mmulataccneg, A_MMULATNEG) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULBTACC, mmulbtacc, A_MMULBT) \
  ZTT_WIDE_MATMUL_ENTRY (ID, NAME, K, MMULBTACCNEG, mmulbtaccneg, A_MMULBTNEG)
#define ZTT_WIDE_MATMUL_TYPE(ID, NAME) \
  ZTT_WIDE_MATMUL_K (ID, NAME, 1) \
  ZTT_WIDE_MATMUL_K (ID, NAME, 2) \
  ZTT_WIDE_MATMUL_K (ID, NAME, 4) \
  ZTT_WIDE_MATMUL_K (ID, NAME, 8) \
  ZTT_WIDE_MATMUL_K (ID, NAME, 16)
ZTT_WIDE_MATMUL_TYPE (I64_RNU, i64_rnu)
ZTT_WIDE_MATMUL_TYPE (I64_RNE, i64_rne)
ZTT_WIDE_MATMUL_TYPE (I64_RDN, i64_rdn)
ZTT_WIDE_MATMUL_TYPE (I64_ROD, i64_rod)
ZTT_WIDE_MATMUL_TYPE (U64_RNU, u64_rnu)
ZTT_WIDE_MATMUL_TYPE (U64_RNE, u64_rne)
ZTT_WIDE_MATMUL_TYPE (U64_RDN, u64_rdn)
ZTT_WIDE_MATMUL_TYPE (U64_ROD, u64_rod)
ZTT_WIDE_MATMUL_TYPE (I128_RNU, i128_rnu)
ZTT_WIDE_MATMUL_TYPE (I128_RNE, i128_rne)
ZTT_WIDE_MATMUL_TYPE (I128_RDN, i128_rdn)
ZTT_WIDE_MATMUL_TYPE (I128_ROD, i128_rod)
ZTT_WIDE_MATMUL_TYPE (U128_RNU, u128_rnu)
ZTT_WIDE_MATMUL_TYPE (U128_RNE, u128_rne)
ZTT_WIDE_MATMUL_TYPE (U128_RDN, u128_rdn)
ZTT_WIDE_MATMUL_TYPE (U128_ROD, u128_rod)
#undef ZTT_WIDE_MATMUL_TYPE
#undef ZTT_WIDE_MATMUL_K
#undef ZTT_WIDE_MATMUL_ENTRY
