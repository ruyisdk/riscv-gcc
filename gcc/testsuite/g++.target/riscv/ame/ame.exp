# AME/Ztt tests, grouped by the rule under test.
if ![istarget riscv*-*-*] then {
    return
}

load_lib g++-dg.exp

# Each test selects its own ISA, profile, and optimization options.
# In particular, do not enable Ztt for the negative feature tests here.
dg-init

# Start the forced-GC tests early so parallel workers can overlap them.
foreach group {
    typed
    types/floating
    matrix/floating
    matrix/math
    acc/base
    acc/concat
    acc/matmul
    acc/mixed
    acc/packed
    acc/packed-large
    acc/packed-matmul
    acc/state
    acc/tuple
    acc/tuple-matmul
    acc/width
    acc/wide-matmul
    acc/integer-matmul
    acc/floating-matmul
    acc/large-groups
    base
    frame
    matrix/abs
    matrix/ternary
    matrix/arithmetic
    matrix/bitwise
    matrix/broadcast
    matrix/clear-zero
    matrix/compare
    matrix/construct
    matrix/convert
    matrix/copy
    matrix/indexed
    matrix/minmax
    matrix/memory
    matrix/mul
    matrix/permute
    matrix/reduce
    matrix/scalar-arithmetic
    matrix/scalar-bitwise
    matrix/scalar-ternary
    matrix/shift
    matrix/sub
    matrix/utils
    matrix/wide
    matrix/integer-kinds
    scalar/wide
    scalar/integer-broadcast
    scalar/integer-kinds
    scalar/floating
    scalar/floating-broadcast
    scalar/exponent
    memory/floating
    memory/alignment
    memory/wide128
    matrix/zip
    profile
    rounding
    runtime-n
    state
    types
    types/wide
    types/integer-kinds
    types/large-groups
    uds
} {
    dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/$group/*.C]] "" ""
}

# Keep the same profile/optimization matrix as the C tests, without
# duplicating the source or overriding the selected optimization level.
foreach group {acc/packed matrix/mul matrix/permute scalar/exponent calls state} {
    foreach flags {{-O0} {-O2}} {
	dg-runtest [lsort [glob -nocomplain \
	    $srcdir/$subdir/$group/optimizations/*.C]] $flags ""
    }
}

dg-finish
